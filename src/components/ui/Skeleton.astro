---
/**
 * Skeleton loader: placeholder hoạt ảnh xung nhịp
 */
export interface Props {
  class?: string
  variant?: "default" | "circular" | "rounded"
}

const { class: className = "", variant = "default" } = Astro.props

const variantClasses = {
  default: "rounded",
  circular: "rounded-full",
  rounded: "rounded-xl",
}
---

<div
  class={`animate-pulse bg-muted/80 ${variantClasses[variant]} ${className}`}
  aria-hidden="true"
></div>
