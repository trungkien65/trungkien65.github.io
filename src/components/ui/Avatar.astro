---
/**
 * Avatar component: hình ảnh đại diện hoặc chữ viết tắt
 */
export interface Props {
  src?: string
  alt?: string
  fallback?: string
  size?: "sm" | "md" | "lg" | "xl"
  class?: string
}

const {
  src,
  alt = "Avatar",
  fallback = "U",
  size = "md",
  class: className = "",
} = Astro.props

const sizeClasses = {
  sm: "h-8 w-8 text-xs",
  md: "h-10 w-10 text-sm",
  lg: "h-12 w-12 text-base",
  xl: "h-16 w-16 text-xl",
}
---

<div
  class={`relative inline-flex shrink-0 select-none items-center justify-center overflow-hidden rounded-full bg-muted font-medium text-foreground ${sizeClasses[size]} ${className}`}
>
  {
    src ? (
      <img
        src={src}
        alt={alt}
        class="h-full w-full object-cover"
        loading="lazy"
      />
    ) : (
      <span class="font-semibold uppercase tracking-wider">{fallback}</span>
    )
  }
</div>
