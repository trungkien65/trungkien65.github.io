---
/**
 * Divider / Separator component
 */
export interface Props {
  orientation?: "horizontal" | "vertical"
  class?: string
  label?: string
}

const {
  orientation = "horizontal",
  class: className = "",
  label,
} = Astro.props
---

{
  label ? (
    <div class={`relative my-4 flex items-center ${className}`}>
      <div class="grow border-t border-border"></div>
      <span class="mx-3 shrink text-xs uppercase tracking-wider text-muted-foreground">
        {label}
      </span>
      <div class="grow border-t border-border"></div>
    </div>
  ) : orientation === "vertical" ? (
    <div
      role="separator"
      aria-orientation="vertical"
      class={`inline-block h-full min-h-[1em] w-[1px] bg-border ${className}`}
    ></div>
  ) : (
    <hr
      role="separator"
      class={`my-4 border-0 border-t border-border ${className}`}
    />
  )
}
