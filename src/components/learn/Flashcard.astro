---
/**
 * Flashcard 3D: Lật thẻ hai mặt mượt mà với âm thanh phát âm và phím tắt.
 */
import { Button } from "@/components/ui"
---

<div class="mx-auto max-w-xl space-y-4" data-learn-flashcard>
  <!-- Progress Header -->
  <div class="space-y-1.5">
    <div class="flex items-center justify-between text-xs font-medium text-muted-foreground">
      <span class="flex items-center gap-1.5">
        <span class="inline-block h-2 w-2 rounded-full bg-primary animate-pulse"></span>
        Tiến độ học thẻ
      </span>
      <span
        data-flash-progress
        class="rounded-full bg-muted/80 px-2.5 py-0.5 text-xs font-semibold text-foreground shadow-sm"
      >
        0 / 0
      </span>
    </div>
    <div class="h-2 w-full overflow-hidden rounded-full bg-muted/60">
      <div
        data-flash-progress-bar
        class="h-full rounded-full bg-primary transition-all duration-300 ease-out"
        style="width: 0%"
      ></div>
    </div>
  </div>

  <!-- 3D Flip Card Container -->
  <div class="perspective-1000 w-full select-none" data-flash-card-container>
    <div
      data-flash-card-inner
      class="group relative min-h-[280px] sm:min-h-[320px] w-full cursor-pointer rounded-2xl border-2 border-border/80 bg-card p-6 shadow-md transition-all duration-500 transform-style-3d hover:border-primary/50 hover:shadow-xl"
    >
      <!-- Front Face (Hán tự) -->
      <div
        data-flash-face="front"
        class="absolute inset-0 flex flex-col justify-between p-6 backface-hidden rounded-2xl bg-gradient-to-b from-card to-muted/20"
      >
        <div class="flex items-center justify-between">
          <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
            Hán tự
          </span>
          <button
            type="button"
            data-flash-speak
            title="Nghe phát âm (zh-CN)"
            class="flex h-8 w-8 items-center justify-center rounded-full bg-muted/60 text-muted-foreground transition-colors hover:bg-primary/20 hover:text-primary"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" strokeLinejoin="round" strokeWidth="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
            </svg>
          </button>
        </div>

        <div class="my-auto text-center">
          <p
            data-flash-term
            lang="zh-Hans"
            class="text-6xl sm:text-7xl font-bold tracking-tight text-foreground transition-transform group-hover:scale-105"
          ></p>
        </div>

        <div class="flex items-center justify-center gap-1.5 text-xs text-muted-foreground">
          <span>Nhấn vào thẻ hoặc phím</span>
          <kbd class="rounded border border-border bg-muted px-1.5 py-0.5 text-[10px] font-semibold text-foreground">Space</kbd>
          <span>để lật</span>
        </div>
      </div>

      <!-- Back Face (Ý nghĩa / Pinyin) -->
      <div
        data-flash-face="back"
        class="absolute inset-0 flex flex-col justify-between p-6 rotate-y-180 backface-hidden rounded-2xl bg-gradient-to-b from-card to-primary/5"
      >
        <div class="flex items-center justify-between">
          <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
            Nghĩa & Phiên âm
          </span>
          <button
            type="button"
            data-flash-speak-back
            title="Nghe phát âm (zh-CN)"
            class="flex h-8 w-8 items-center justify-center rounded-full bg-muted/60 text-muted-foreground transition-colors hover:bg-primary/20 hover:text-primary"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" strokeLinejoin="round" strokeWidth="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
            </svg>
          </button>
        </div>

        <div class="my-auto px-4 text-center">
          <p
            data-flash-definition
            class="text-xl sm:text-2xl font-semibold leading-relaxed text-foreground"
          ></p>
        </div>

        <div class="text-center text-xs text-muted-foreground">
          Nhấn để lật lại mặt trước
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Action Buttons -->
  <div class="flex items-center justify-between gap-3 pt-2">
    <Button type="button" variant="outline" size="sm" data-flash-prev class="flex-1 sm:flex-initial">
      <span class="mr-1">←</span> Trước
    </Button>
    <Button type="button" variant="secondary" size="sm" data-flash-flip class="flex-1 font-medium shadow-sm">
      Lật thẻ
    </Button>
    <Button type="button" variant="primary" size="sm" data-flash-next class="flex-1 sm:flex-initial">
      Tiếp <span class="ml-1">→</span>
    </Button>
  </div>
</div>
