---
/**
 * Thẻ một bộ thủ Khang Hy: Glyph nổi bật bên trái, thông tin chi tiết phiên âm, nét và nghĩa bên phải.
 */
import type { RadicalItem } from "@/lib/api/radicals"

type Props = RadicalItem

const { glyph, kangxiNumber, strokeCount, pinyin, english, nameVi } = Astro.props

const ariaLabel = `Bộ thủ số ${kangxiNumber}, ${nameVi}`
---

<div class="contents min-w-0" data-radical-card aria-label={ariaLabel}>
  <div class="group relative flex min-h-[105px] items-stretch overflow-hidden rounded-xl border border-border/80 bg-card p-3 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-md">
    <!-- Left: Large Radical Glyph -->
    <div
      class="flex min-w-[70px] select-none items-center justify-center rounded-lg bg-muted/40 text-5xl sm:text-6xl font-bold leading-none text-foreground font-serif transition-transform group-hover:scale-105"
      data-radical-glyph
      lang="zh-Hans"
    >
      {glyph}
    </div>

    <!-- Right: Radical Details -->
    <div
      class="flex min-w-0 flex-1 flex-col justify-center gap-1 pl-3 text-left"
      data-radical-info
    >
      <div class="flex items-center justify-between gap-1">
        <span
          class="inline-block rounded bg-primary/10 px-1.5 py-0.5 text-[10px] font-semibold text-primary"
          data-radical-badge
        >
          #{kangxiNumber} · {strokeCount} nét
        </span>
        <span class="text-[11px] font-medium text-muted-foreground" data-radical-pinyin>
          {pinyin}
        </span>
      </div>

      <div
        class="line-clamp-1 text-sm font-bold text-foreground group-hover:text-primary transition-colors"
        data-radical-name-vi
      >
        {nameVi}
      </div>

      <div
        class="line-clamp-1 text-[11px] text-muted-foreground"
        data-radical-english
        lang="en"
      >
        {english}
      </div>
    </div>
  </div>
</div>
