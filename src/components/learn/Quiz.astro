---
/**
 * Quiz trắc nghiệm hiện đại với phản hồi tương tác, phím tắt A-D và chuỗi điểm streak.
 */
import { Button, Card, Text } from "@/components/ui"
---

<div class="mx-auto max-w-xl space-y-4" data-learn-quiz>
  <!-- Quiz Header -->
  <div class="flex items-center justify-between text-xs font-medium">
    <div class="flex items-center gap-2">
      <span class="rounded-full bg-primary/10 px-2.5 py-0.5 font-semibold text-primary" data-quiz-progress>
        Câu 1
      </span>
      <span data-quiz-streak class="hidden items-center gap-1 rounded-full bg-amber-500/10 px-2 py-0.5 text-amber-600 dark:text-amber-400 font-semibold">
        🔥 <span data-quiz-streak-count>0</span>
      </span>
    </div>
    <span class="text-xs text-muted-foreground">Chọn 1 trong 4 đáp án đúng</span>
  </div>

  <!-- Quiz Question Card -->
  <Card variant="elevated" class="overflow-hidden border-2 border-border/80 p-6 shadow-md">
    <div class="space-y-6">
      <div class="text-center">
        <Text variant="small" class="text-muted-foreground uppercase tracking-wider text-[11px] font-semibold">
          Nghĩa đúng của từ là gì?
        </Text>
        <div class="mt-2 flex items-center justify-center gap-3">
          <p data-quiz-term lang="zh-Hans" class="text-5xl sm:text-6xl font-bold tracking-tight text-foreground font-serif"></p>
          <button
            type="button"
            data-quiz-speak
            title="Nghe phát âm"
            class="flex h-8 w-8 items-center justify-center rounded-full bg-muted/60 text-muted-foreground hover:bg-primary/20 hover:text-primary transition-colors"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" strokeLinejoin="round" strokeWidth="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Quiz Choices Container -->
      <div data-quiz-options class="grid gap-2.5"></div>

      <!-- Feedback Area -->
      <div data-quiz-feedback class="min-h-[1.5rem] rounded-lg text-center text-sm font-semibold transition-all"></div>
    </div>
  </Card>

  <!-- Quiz Next Action -->
  <div class="flex items-center justify-end pt-2">
    <Button type="button" variant="primary" data-quiz-next class="w-full sm:w-auto px-6 font-medium shadow-sm">
      Câu tiếp theo →
    </Button>
  </div>
</div>
