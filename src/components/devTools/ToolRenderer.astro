---
/**
 * Shell ToolCard + React island theo toolId (mỗi tool tự quản lý state qua hook riêng).
 */
import ToolCard from "@/components/devTools/ToolCard.astro"
import Base64Tool from "@/components/devTools/tools/Base64Tool"
import CaseTool from "@/components/devTools/tools/CaseTool"
import ColorTool from "@/components/devTools/tools/ColorTool"
import CronTool from "@/components/devTools/tools/CronTool"
import CsvTool from "@/components/devTools/tools/CsvTool"
import DiffTool from "@/components/devTools/tools/DiffTool"
import HashTool from "@/components/devTools/tools/HashTool"
import HeadersTool from "@/components/devTools/tools/HeadersTool"
import HtmlTool from "@/components/devTools/tools/HtmlTool"
import JsonConvertTool from "@/components/devTools/tools/JsonConvertTool"
import JsonFormatterTool from "@/components/devTools/tools/JsonFormatterTool"
import JsonTypeTool from "@/components/devTools/tools/JsonTypeTool"
import JwtTool from "@/components/devTools/tools/JwtTool"
import NumberBaseTool from "@/components/devTools/tools/NumberBaseTool"
import QueryTool from "@/components/devTools/tools/QueryTool"
import RegexTool from "@/components/devTools/tools/RegexTool"
import RelativeTool from "@/components/devTools/tools/RelativeTool"
import SlugTool from "@/components/devTools/tools/SlugTool"
import TimestampTool from "@/components/devTools/tools/TimestampTool"
import UrlTool from "@/components/devTools/tools/UrlTool"
import UuidTool from "@/components/devTools/tools/UuidTool"
import { Text } from "@/components/ui"
import { ALL_TOOLS } from "@/lib/devTools/config"

interface Props {
  toolId: string
}

const { toolId } = Astro.props
const tool = ALL_TOOLS.find((t) => t.id === toolId)
const title = tool?.label ?? toolId
const description = tool?.description
---

{!tool && (
  <Text variant="small" class="text-muted-foreground">
    Tool chưa có.
  </Text>
)}

{tool && toolId === "jwt" && (
  <ToolCard title={title} description={description}>
    <JwtTool client:visible />
  </ToolCard>
)}

{tool && toolId === "hash" && (
  <ToolCard title={title} description={description}>
    <HashTool client:visible />
  </ToolCard>
)}

{tool && toolId === "case" && (
  <ToolCard title={title} description={description}>
    <CaseTool client:visible />
  </ToolCard>
)}

{tool && toolId === "json-type" && (
  <ToolCard title={title} description={description}>
    <JsonTypeTool client:visible />
  </ToolCard>
)}

{tool && toolId === "uuid" && (
  <ToolCard title={title} description={description}>
    <UuidTool client:visible />
  </ToolCard>
)}

{tool && toolId === "json" && (
  <ToolCard title={title} description={description}>
    <JsonFormatterTool client:visible />
  </ToolCard>
)}

{tool && toolId === "json-xml" && (
  <ToolCard title={title} description={description}>
    <JsonConvertTool kind="xml" client:visible />
  </ToolCard>
)}

{tool && toolId === "json-csv" && (
  <ToolCard title={title} description={description}>
    <JsonConvertTool kind="csv" client:visible />
  </ToolCard>
)}

{tool && toolId === "json-yaml" && (
  <ToolCard title={title} description={description}>
    <JsonConvertTool kind="yaml" client:visible />
  </ToolCard>
)}

{tool && toolId === "base64" && (
  <ToolCard title={title} description={description}>
    <Base64Tool client:visible />
  </ToolCard>
)}

{tool && toolId === "url" && (
  <ToolCard title={title} description={description}>
    <UrlTool client:visible />
  </ToolCard>
)}

{tool && toolId === "query" && (
  <ToolCard title={title} description={description}>
    <QueryTool client:visible />
  </ToolCard>
)}

{tool && toolId === "html" && (
  <ToolCard title={title} description={description}>
    <HtmlTool client:visible />
  </ToolCard>
)}

{tool && toolId === "timestamp" && (
  <ToolCard title={title} description={description}>
    <TimestampTool client:visible />
  </ToolCard>
)}

{tool && toolId === "relative" && (
  <ToolCard title={title} description={description}>
    <RelativeTool client:visible />
  </ToolCard>
)}

{tool && toolId === "regex" && (
  <ToolCard title={title} description={description}>
    <RegexTool client:visible />
  </ToolCard>
)}

{tool && toolId === "cron" && (
  <ToolCard title={title} description={description}>
    <CronTool client:visible />
  </ToolCard>
)}

{tool && toolId === "slug" && (
  <ToolCard title={title} description={description}>
    <SlugTool client:visible />
  </ToolCard>
)}

{tool && toolId === "diff" && (
  <ToolCard title={title} description={description}>
    <DiffTool client:visible />
  </ToolCard>
)}

{tool && toolId === "headers" && (
  <ToolCard title={title} description={description}>
    <HeadersTool client:visible />
  </ToolCard>
)}

{tool && toolId === "csv" && (
  <ToolCard title={title} description={description}>
    <CsvTool client:visible />
  </ToolCard>
)}

{tool && toolId === "color" && (
  <ToolCard title={title} description={description}>
    <ColorTool client:visible />
  </ToolCard>
)}

{tool && toolId === "number-base" && (
  <ToolCard title={title} description={description}>
    <NumberBaseTool client:visible />
  </ToolCard>
)}
