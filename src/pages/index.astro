---
/**
 * Dashboard home: welcome + quick links.
 */
import { DashboardLayout } from "@/layouts"
import { Heading, Link, Text } from "@/components/ui"
---
<DashboardLayout
  title="Dashboard"
  description="Tổng quan dashboard cá nhân: học từ vựng & bộ thủ, dev tools tiện ích, quản lý tài khoản."
>
  <div class="space-y-6">
    <Heading as="h1" size="xl" class="mb-4">Welcome</Heading>
    <Text variant="lead" class="mb-6">
      Trang tổng quan cá nhân. Bắt đầu luyện tập tiếng Trung tại <Link href="/learn/vocab">Học từ vựng</Link> hoặc tra cứu <Link href="/learn/radicals">214 Bộ thủ</Link>.
    </Text>
  </div>
</DashboardLayout>
