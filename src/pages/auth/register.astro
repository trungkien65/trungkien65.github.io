---
/**
 * Đăng ký — sử dụng React Hook Form + useController (RegisterForm).
 */
import { PublicLayout } from "@/layouts"
import { Card, Heading, Link, Text } from "@/components/ui"
import { RegisterForm } from "@/components/auth/RegisterForm"
---

<PublicLayout
  title="Đăng ký"
  description="Tạo tài khoản mới để bắt đầu sử dụng dashboard."
  noindex={true}
>
  <div class="mx-auto max-w-md space-y-6">
    <div class="text-center sm:text-left">
      <Heading as="h1" size="xl">Tạo tài khoản</Heading>
      <Text variant="muted" class="mt-1">Điền thông tin để bắt đầu hành trình học tập</Text>
    </div>
    <Card variant="bordered" class="p-6">
      <RegisterForm client:load />
      <div class="mt-6 border-t border-border pt-4">
        <Text variant="small" class="block text-center text-muted-foreground">
          Đã có tài khoản? <Link href="/auth/login" class="font-medium text-primary">Đăng nhập</Link>
        </Text>
      </div>
    </Card>
  </div>
</PublicLayout>
