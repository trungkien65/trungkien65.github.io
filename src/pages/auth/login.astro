---
/**
 * Đăng nhập — sử dụng React Hook Form + useController (LoginForm).
 */
import { PublicLayout } from "@/layouts"
import { Card, Heading, Link, Text } from "@/components/ui"
import { LoginForm } from "@/components/auth/LoginForm"
---

<PublicLayout
  title="Đăng nhập"
  description="Đăng nhập vào tài khoản để truy cập các tính năng cá nhân hoá."
  noindex={true}
>
  <div class="mx-auto max-w-md space-y-6">
    <div class="text-center sm:text-left">
      <Heading as="h1" size="xl">Đăng nhập</Heading>
      <Text variant="muted" class="mt-1">Nhập thông tin tài khoản của bạn để tiếp tục</Text>
    </div>
    <Card variant="bordered" class="p-6">
      <LoginForm client:load />
      <div class="mt-6 border-t border-border pt-4">
        <Text variant="small" class="block text-center text-muted-foreground">
          Chưa có tài khoản? <Link href="/auth/register" class="font-medium text-primary">Đăng ký ngay</Link>
          <span class="mx-2">·</span>
          <Link href="/dev-tools">Dev Tools</Link>
        </Text>
      </div>
    </Card>
  </div>
</PublicLayout>
