---
/**
 * Danh sách bộ thủ Kangxi — GET /learning/radicals (React Island).
 */
import { RadicalsApp } from "@/components/learn/react"
import { Heading, Link, Text } from "@/components/ui"
import { DashboardLayout } from "@/layouts"
---

<DashboardLayout
  title="Bộ thủ"
  description="Danh sách 214 bộ thủ Kangxi theo số nét, tra cứu pinyin và nghĩa tiếng Việt."
>
  <div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <Heading as="h1" size="xl" class="mb-1">214 Bộ thủ Khang Hy</Heading>
        <Text variant="muted">
          Hệ thống bộ thủ chuẩn tiếng Trung phân loại theo số nét, phiên âm và giải nghĩa.
        </Text>
      </div>
      <Text variant="small">
        <Link href="/learn/vocab" class="inline-flex items-center gap-1 rounded-lg bg-primary/10 px-3 py-1.5 font-semibold text-primary transition-colors hover:bg-primary/20">
          Học từ vựng →
        </Link>
      </Text>
    </div>

    <div>
      <RadicalsApp client:load />
    </div>
  </div>
</DashboardLayout>
