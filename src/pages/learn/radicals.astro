---
/**
 * Danh sách bộ thủ Kangxi — GET /learning/radicals (public, cache GET).
 */
import RadicalCard from "@/components/learn/RadicalCard.astro"
import { Heading, Link, Text } from "@/components/ui"
import { DashboardLayout } from "@/layouts"
---

<DashboardLayout
  title="Bộ thủ"
  description="Danh sách 214 bộ thủ Kangxi theo số nét, tra cứu pinyin và nghĩa tiếng Việt."
>
  <template id="radical-card-tmpl" class="hidden">
    <RadicalCard
      glyph="一"
      kangxiNumber={1}
      strokeCount={1}
      pinyin=" "
      english=" "
      nameVi=" "
    />
  </template>

  <div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <Heading as="h1" size="xl" class="mb-1">214 Bộ thủ Khang Hy</Heading>
        <Text variant="muted">
          Hệ thống bộ thủ chuẩn tiếng Trung phân loại theo số nét, phiên âm và giải nghĩa.
        </Text>
      </div>
      <Text variant="small">
        <Link href="/learn/vocab" class="inline-flex items-center gap-1 rounded-lg bg-primary/10 px-3 py-1.5 font-semibold text-primary transition-colors hover:bg-primary/20">
          Học từ vựng →
        </Link>
      </Text>
    </div>

    <!-- Search Input Bar -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
      <div class="relative flex-1 max-w-md">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-muted-foreground">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" strokeLinejoin="round" strokeWidth="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="search"
          data-radicals-search
          placeholder="Tìm theo chữ Hán, Pinyin, nghĩa tiếng Việt..."
          class="flex h-10 w-full rounded-xl border border-border bg-card pl-9 pr-4 text-sm text-foreground shadow-sm placeholder:text-muted-foreground transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        />
      </div>
      <div data-radicals-meta class="hidden text-xs font-semibold text-muted-foreground sm:ml-auto"></div>
    </div>

    <div class="space-y-4" data-radicals-app>
      <div data-radicals-status class="rounded-xl border border-border bg-card p-8 text-center text-sm text-muted-foreground">
        Đang tải danh sách 214 bộ thủ...
      </div>
      <div data-radicals-groups class="hidden space-y-10"></div>
    </div>
  </div>
</DashboardLayout>

<script>
  import { initRadicalsPage } from "@/scripts/radicals-page"
  for (const el of document.querySelectorAll("[data-radicals-app]")) {
    initRadicalsPage(document.querySelector(".space-y-6") as HTMLElement || el as HTMLElement)
  }
</script>
