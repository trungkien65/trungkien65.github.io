---
/**
 * Học từ vựng: Flashcard 3D, Quiz trắc nghiệm, Ôn tập SM-2 (React Island).
 */
import { VocabApp } from "@/components/learn/react"
import { Heading, Link, Text } from "@/components/ui"
import { DashboardLayout } from "@/layouts"
---

<DashboardLayout
  title="Học từ vựng"
  description="Luyện tập từ vựng tiếng Trung qua Flashcard 3D, Quiz trắc nghiệm và thuật toán lặp lại ngắt quãng SM-2."
>
  <div class="space-y-6">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <Heading as="h1" size="xl" class="mb-1">Luyện tập Từ vựng</Heading>
        <Text variant="muted">
          Học từ mới qua Flashcard 3D, kiểm tra với Quiz và củng cố trí nhớ dài hạn bằng thuật toán SM-2.
        </Text>
      </div>
      <Text variant="small">
        <Link href="/learn/radicals" class="inline-flex items-center gap-1 font-medium text-primary hover:underline">
          Tra cứu 214 Bộ thủ →
        </Link>
      </Text>
    </div>

    <div class="mx-auto max-w-3xl">
      <VocabApp client:load />
    </div>
  </div>
</DashboardLayout>
